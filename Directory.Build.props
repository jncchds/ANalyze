<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Product>ANalyze by CHDS</Product>
    <Company>CHDS</Company>
    <Copyright>Copyright © CHDS</Copyright>
    <!-- VERSION at the repo root is the single source of truth (also used to tag Docker images). -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)VERSION').Trim())</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
